# Phase 0 load-test environment -- see docs/SCALE_OUT_PROMPT.md's Phase 0
# section. Copy to `.env.loadtest` (gitignored; `make load-test` does this
# automatically if it's missing, mirroring the repo-root Makefile's own
# `setup` target). Every value here is throwaway, load-test-only
# infrastructure -- never point this file at a real deployment's database
# or credentials.

# --- Ollama: the mock server (eval/load/mock_ollama_server.py), not a
# real model -- see that module's own docstring for why. ---
OLLAMA_HOST=http://mock-ollama:11434
OLLAMA_MODEL=mock-model
OLLAMA_REQUEST_TIMEOUT_SECONDS=30

# --- Business database: the seeded Postgres (eval/load/seed/schema.sql),
# applied once at stack startup -- see docker-compose.loadtest.yml. ---
DB_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=loadtest_business
DB_USER=loadtest
DB_PASSWORD=loadtest
DB_SCHEMA=
DB_CONNECTION_STRING=
DB_CONNECTIONS=

# --- ChromaDB (schema-embedding index) -- unchanged from local-dev
# defaults; this Phase 0 harness does not touch Chroma's own deployment
# shape (that's Phase 5's "shared data tier" concern, not this one's). ---
CHROMA_PERSIST_DIR=./embeddings/.chroma
CHROMA_COLLECTION_NAME=schema_ddl
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Local self-hosted accounts: a second database on the same throwaway
# Postgres instance, never the business database above (see
# identity/__init__.py's own "never the same database" rule, which this
# harness deliberately still honors even though both databases here are
# equally throwaway). ---
LOCAL_AUTH_ENABLED=true
AUTH_DATABASE_URL=postgresql+psycopg2://loadtest:loadtest@postgres:5432/loadtest_identity
AUTH_DATABASE_POOL_SIZE=20
AUTH_DATABASE_MAX_OVERFLOW=40
ALLOW_PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false

# HS256 with a fixed local secret -- fine for throwaway load-test
# infrastructure; a real deployment must never do this (see
# docs/SCALE_OUT_PROMPT.md Phase 7 #1 for the production-grade RS256/JWKS
# plan this harness deliberately does not attempt).
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=load-test-only-secret-do-not-reuse-anywhere-real
JWT_ISSUER=text-to-sql-agent-loadtest
JWT_AUDIENCE=text-to-sql-web-loadtest
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- eval/load/seed_users.py's own knobs ---
LOAD_TEST_USER_COUNT=50
LOAD_TEST_USER_PASSWORD=LoadTest!Passw0rd123
LOAD_TEST_USER_EMAIL_DOMAIN=loadtest.example.internal

# --- Kept off: this harness measures the core ask/execute/history path
# (see SCALE_OUT_PROMPT.md's Phase 0 scenario list); every optional source
# below adds its own dependency-import/model-load cost to the API process
# for a path this load test never exercises. Confirmed in Phase 0's own
# research pass that ENABLE_VOICE_MODE/ENABLE_MEDIA_SEARCH/
# ENABLE_CHAT_ATTACHMENTS default to true in config/settings.py -- set
# false here deliberately, not left at their real-app defaults. ---
ENABLE_MULTI_SOURCE_ROUTER=false
ENABLE_DOCUMENT_RAG=false
ENABLE_POLICY_RAG=false
ENABLE_WEB_SEARCH=false
ENABLE_MEDIA_GENERATION=false
ENABLE_VOICE_MODE=false
ENABLE_MEDIA_SEARCH=false
ENABLE_CHAT_ATTACHMENTS=false

# Left at real-app defaults (both true) so the load test still exercises
# the real per-question Chroma lookups these add -- neither makes an extra
# LLM call, both are cheap, and this is more representative of real usage
# than disabling them. Query planning/review IS an extra LLM call, but
# only for a question matching a "complex" heuristic
# (agent/complexity.py) -- eval/load/k6/scenario_ask_flow.js's questions
# are deliberately simple so this harness's numbers reflect the common
# case, not the complex-question path.
ENABLE_GOLDEN_EXAMPLES=true
ENABLE_BUSINESS_CONTEXT_RETRIEVAL=true
ENABLE_QUERY_PLANNING=true

# --- Rate/concurrency limits: deliberately loosened from the real app's
# defaults for this load-test harness -- with a fixed pool of
# LOAD_TEST_USER_COUNT synthetic users each firing far more than one
# question per minute (a real per-minute anti-abuse limit sized for real
# human usage), the *rate* limiter would dominate every measurement below
# instead of the actual thing Phase 0 is trying to measure (API-tier
# concurrency/latency behavior). The concurrency limits are left at
# defaults -- those ARE part of what this harness measures. Never copy
# QUESTION_RATE_LIMIT_PER_MINUTE's value here into a real deployment's
# .env; agent/rate_limit.py's own tests cover the limiter's correctness
# in isolation, which is why it's safe to loosen only for this harness. ---
QUESTION_RATE_LIMIT_PER_MINUTE=100000
LLM_CALL_RATE_LIMIT_PER_MINUTE=100000
# LOGIN_RATE_LIMIT_PER_MINUTE is keyed by client IP (brute-force
# protection, not per-account) -- every k6 VU shares this container's one
# source IP, so the real default (10/min) would let only the first ~10 of
# many concurrent VUs ever log in, then 429 every VU for the rest of the
# run. Real production brute-force protection is unaffected; only this
# harness's own self-inflicted flood is what this loosens.
LOGIN_RATE_LIMIT_PER_MINUTE=100000

ENVIRONMENT=development
LOG_LEVEL=INFO
