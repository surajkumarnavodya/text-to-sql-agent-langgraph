# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Env / secrets ---
.env
*.local.env

# --- App data (regenerated by scripts/build_embeddings.py from the live DB) ---
embeddings/.chroma/

# --- Downloaded Piper voice model (scripts/download_voice_model.py) ---
voice/models/

# --- Extracted video keyframe thumbnails (scripts/build_media_index.py) ---
media/.thumbnails/

# --- Local media search library (this developer's own MEDIA_LIBRARY_PATH
# content -- personal images/video, never project source) ---
media_library/

# --- Local database files (this project connects to a real DB via SQLAlchemy;
# no bundled/local DB file is ever expected -- see CLAUDE.md's DuckDB history
# note -- this is defensive, in case one shows up locally during dev) ---
*.duckdb
*.sqlite
*.sqlite3
*.db

# --- Local runtime logs (e.g. redirected uvicorn stdout/stderr during
# manual dev-session testing) -- never build artifacts or app source ---
*.log

# --- Security-benchmark run output (eval/security_benchmark/, scripts/
# run_security_benchmark.py) -- a *_full.json result can contain real
# leaked content (a secret value's context, a system-prompt fragment) on a
# failing case; even the compact form reveals which live adversarial
# prompts currently succeed. Deliberately stricter than eval/results/
# eval/baselines/ (the accuracy benchmark's own equivalents, which this
# repo does commit) -- see docs/security/PROMPT_INJECTION_BENCHMARK_GAP_REPORT.md. ---
eval/security_results/
eval/security_baselines/

# --- Test / lint / type-check caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# --- Visual Studio ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
bin/
obj/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/
.idea/
