# Copy this file to .env and fill in your real database connection details.
# .env is gitignored -- never commit real credentials.

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# --- Database connection ---
# DB_TYPE selects the driver: postgresql | mysql | mssql | oracle
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_readonly_user
DB_PASSWORD=your_password
# Optional: restrict introspection (and what the LLM sees) to one schema
# instead of the whole database. Leave blank to use the connection's default.
DB_SCHEMA=
# Optional: full connection-string override. If set, DB_TYPE/DB_HOST/DB_PORT/
# DB_NAME/DB_USER/DB_PASSWORD above are ignored entirely.
DB_CONNECTION_STRING=
# Only used when DB_TYPE=mssql -- must match an ODBC driver installed on
# this machine (Control Panel > ODBC Data Sources, or `odbcinst -j` on
# Linux/macOS). Common values: "ODBC Driver 17 for SQL Server",
# "ODBC Driver 18 for SQL Server".
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- Multiple databases (optional) ---
# Leave DB_CONNECTIONS unset for a plain single-database setup (the DB_* block
# above is used as-is, internally named "default"). To connect to more than
# one database and have the agent auto-route each question to whichever one
# looks relevant (see embeddings/retriever.py::select_database -- no manual
# picker, the agent decides), set DB_CONNECTIONS to a comma-separated list of
# names, then repeat the same DB_* fields per name as DB_<NAME>_*
# (the name uppercased, non-alphanumeric characters replaced with `_`):
#
# DB_CONNECTIONS=sales,hr
# DB_SALES_TYPE=postgresql
# DB_SALES_HOST=sales-db.internal
# DB_SALES_PORT=5432
# DB_SALES_NAME=sales
# DB_SALES_USER=sales_reader
# DB_SALES_PASSWORD=...
# DB_HR_TYPE=mysql
# DB_HR_HOST=hr-db.internal
# DB_HR_PORT=3306
# DB_HR_NAME=hr
# DB_HR_USER=hr_reader
# DB_HR_PASSWORD=...
#
# Each connection also accepts its own DB_<NAME>_SCHEMA, DB_<NAME>_CONNECTION_STRING,
# and DB_<NAME>_ODBC_DRIVER, matching the unprefixed fields above.
DB_CONNECTIONS=

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./embeddings/.chroma
CHROMA_COLLECTION_NAME=schema_ddl
# Sentence-transformers model used for embedding schema DDL and questions.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SCHEMA_TOP_K=4

# --- Agent limits (see CLAUDE.md "Sandbox/resource limits") ---
MAX_RETRIES=3
# Extra retries (on top of MAX_RETRIES) for questions that look like they need
# more self-correction cycles (top-N-per-group, YoY/period growth, multiple
# metrics at once) -- see agent/complexity.py. 0 disables the adaptive bonus.
COMPLEX_QUERY_MAX_RETRY_BONUS=2
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=1024
# Max tokens for the post-query plain-English insight sentence (1-2
# sentences, so kept much smaller than LLM_MAX_TOKENS above).
INSIGHT_MAX_TOKENS=120
# Max accepted length (characters) of a typed question -- rejected with a
# clear message rather than silently truncated (see agent/input_guard.py).
MAX_QUESTION_LENGTH=500

# --- Agentic query planning + plan-conformance self-correction
# (agent/nodes.py::plan_query_node / review_sql_node) ---
# Only triggers for questions agent/complexity.py judges non-trivial (same
# signals as COMPLEX_QUERY_MAX_RETRY_BONUS above) -- an ordinary question
# makes zero extra LLM calls regardless of this flag being on.
ENABLE_QUERY_PLANNING=true
QUERY_PLAN_MAX_TOKENS=300
SQL_REVIEW_MAX_TOKENS=200

# --- Golden-dataset feedback loop (embeddings/golden_examples.py,
# agent/nodes.py::retrieve_golden_examples_node) ---
# A thumbs-up on a confirmed-correct result in the UI saves that
# (question, SQL) pair to a per-database ChromaDB collection; the
# best-matching saved examples are retrieved and injected as few-shot
# examples into future similar questions. Safe no-op until a user has
# saved at least one example -- nothing to retrieve yet.
ENABLE_GOLDEN_EXAMPLES=true
GOLDEN_EXAMPLES_TOP_K=3
# Minimum cosine similarity (0.0-1.0) a saved example must clear to
# actually be injected -- a poor match is withheld entirely rather than
# shown, since a misleading example is worse than none.
GOLDEN_EXAMPLES_MIN_SIMILARITY=0.75

# --- Rate limiting (see agent/rate_limit.py; basic in-memory safeguard for
# local/single-user use, see SECURITY.md) ---
# Max question submissions per minute, per client IP.
QUESTION_RATE_LIMIT_PER_MINUTE=10
# Max LLM *generation* calls per minute, process-wide -- stricter than and
# separate from the above, since one question's retries can multiply calls.
LLM_CALL_RATE_LIMIT_PER_MINUTE=20
# Max calls per minute, per client IP, to POST /execute, POST /schema/refresh,
# the mutating /documents routes, and POST /generate/confirm.
API_ACTION_RATE_LIMIT_PER_MINUTE=20

# --- Proactive query cost estimation (see db/query_cost.py) ---
# Runs a non-executing EXPLAIN/SHOWPLAN before a validated query executes.
# Always fails open (skips the check) on any error or timeout.
COST_ESTIMATION_ENABLED=true
COST_ESTIMATION_TIMEOUT_SECONDS=3
# Estimated rows above which a query still runs, but the UI shows a
# "this may take a moment" notice first.
COST_MODERATE_ROW_THRESHOLD=50000
# Estimated rows above which a query is not run at all -- treated as a
# retryable error fed back to the generation node instead.
COST_HIGH_ROW_THRESHOLD=1000000

# --- Logging ---
LOG_LEVEL=INFO
# How much result-set shape observability/redaction.py includes when
# logging a query result -- "standard" (row/column counts + column names,
# never cell values) or "strict" (drops column names too, leaving only
# counts -- column names can themselves be sensitive in some schemas).
LOG_REDACTION_LEVEL=standard

# --- REST API (api/, see docs/API.md) ---
# Optional bearer token required on every api/ request when set (checked
# against the `Authorization: Bearer <token>` header). Leave blank to run
# the API with no auth check of its own -- fine for local/trusted-network
# use, but see docs/DEPLOYMENT.md before exposing it beyond that: this is a
# lightweight hook, not a substitute for a real authenticating reverse proxy.
API_AUTH_TOKEN=

# --- Future hosted-model swap (unused by the local flow, kept for parity) ---
# HOSTED_LLM_API_KEY=

# --- Multi-source router (see agent/orchestrator/graph.py's module docstring;
# docs/ARCHITECTURE.md gets a matching section once the multi-source design
# lands in full) ---
# Required only if you want questions routed through agent/orchestrator/
# instead of straight to the SQL agent. False (or unset) makes
# agent.orchestrator.graph.run_orchestrated a pure pass-through to
# agent.graph.run_agent -- the app behaves exactly as it does with this
# whole section left unset. Turning it on today (before any document/
# policy/web source is configured below) still only ever routes to SQL --
# it just makes that routing an inspectable, logged graph step instead of a
# bare function call.
ENABLE_MULTI_SOURCE_ROUTER=false

# --- Document/policy RAG store (see rag/store.py's module docstring) ---
# A dedicated SQL Server 2025+/Azure SQL connection for uploaded PDF chunks +
# embeddings (native VECTOR column type -- confirmed against the actual
# target instance before this was built). Deliberately separate from
# DB_CONNECTIONS above -- chunk storage isn't business data and shouldn't
# share a schema/connection pool with a configured database. Required for
# ENABLE_DOCUMENT_RAG and/or ENABLE_POLICY_RAG below; leave blank and both
# stay unavailable regardless of those flags.
#
# Same LocalDB-style escape hatch as DB_HR_CONNECTION_STRING above if your
# SQL Server instance needs one (named instance, no TCP host:port):
# RAG_STORE_CONNECTION_STRING=mssql+pyodbc:///?odbc_connect=<url-encoded ODBC connection string>
RAG_STORE_CONNECTION_STRING=
RAG_STORE_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Offers the general "documents" collection to the router. Upload PDFs to it
# from the "Knowledge Sources" page in the UI (ui/pages/1_Knowledge_Sources.py).
ENABLE_DOCUMENT_RAG=false
# Offers the separate, more access-sensitive "policies" collection to the
# router -- independent of ENABLE_DOCUMENT_RAG, either can be on alone. A
# policy PDF tagged with a sensitivity category (compensation/disciplinary/
# legal) at upload time is never summarized into an answer -- see
# rag/graph.py's generate-node docstring for why.
ENABLE_POLICY_RAG=false

# Retrieval/chunking tuning shared by both collections.
RAG_TOP_K=4
RAG_MAX_RETRIES=2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
# Blank (default) reuses EMBEDDING_MODEL_NAME above -- the same model already
# embedding schema DDL. Only set this if documents genuinely need a
# different embedding model than schema retrieval does.
RAG_EMBEDDING_MODEL_NAME=
# Stores each uploaded PDF's original bytes (a new column on rag.documents)
# so it can be downloaded later from a chat answer's citation or the
# Knowledge Sources page. True by default -- a real, visible storage-growth
# cost on top of the extracted chunks, unlike the other ENABLE_* flags above,
# so turn this off if that matters for your deployment. Only ever applies to
# documents uploaded after this is turned on.
ENABLE_PDF_DOWNLOAD=true
# Upper bound (MB) on one POST /documents upload -- enforced by reading at
# most this many bytes regardless of what the request claims its size is.
MAX_DOCUMENT_UPLOAD_MB=25

# --- Live web search (see search/web_search.py) ---
# Offers the web_search node to the router. Requires WEB_SEARCH_API_KEY too
# -- both must be set for web search to actually be available.
ENABLE_WEB_SEARCH=false
# Which provider search/web_search.py calls -- see
# search.web_search.SUPPORTED_SEARCH_PROVIDERS for supported values.
# Swapping providers is a config change, not a code change.
WEB_SEARCH_PROVIDER=tavily
# Get a key at https://tavily.com (free tier available) and paste it here.
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# Max tokens for the LLM call that drafts the web-search answer -- larger
# than a typical answer budget since a good web answer synthesizes several
# sources into a structured, in-depth response (headings, lists, an inline
# citation per claim), not a single short sentence.
WEB_SEARCH_ANSWER_MAX_TOKENS=1200

# --- IMA Studio media generation (image/video/audio) ---
# media_gen/, rate limiting, and orchestrator wiring (routed as the
# "generation" source, see agent/orchestrator/nodes.py::generation_node)
# are built, tested, and confirmed working end-to-end against a real IMA
# account (text-to-image generation, download, and serving via
# GET /media/{media_id} all verified with a live call). Video generation
# shares the same client/task-creation code path but hasn't been
# separately confirmed live yet. Get a key at https://imastudio.com
# (dashboard), then set ENABLE_MEDIA_GENERATION=true below to enable --
# left off by default so a fresh clone never spends real IMA credits
# without the operator deliberately opting in.
ENABLE_MEDIA_GENERATION=false
IMA_API_KEY=
IMA_API_BASE_URL=https://api.imastudio.com
# Deliberately tighter than a text-query limit -- generation costs
# meaningfully more per call than a text LLM turn.
MEDIA_GEN_RATE_LIMIT=5
MEDIA_GEN_RATE_WINDOW_SECONDS=60
# Overrides the video model's own default clip length. NOT a "make videos
# any length" knob -- verified live against a real account: the
# auto-selected model ("Seedance 2.0") only accepts an integer 4-15
# (its own declared min/max), default 5. No current IMA video model
# supports a single multi-minute generation -- a real model-capability
# ceiling. Leave unset to use the model's own default; an out-of-range
# value is rejected by IMA itself as a clean provider failure.
MEDIA_GEN_VIDEO_DURATION_SECONDS=
# Generation is a real, metered third-party API call -- the only source in
# the orchestrator that spends money -- so it requires an explicit human
# confirmation (POST /generate/confirm) before IMA is actually called, the
# same way the SQL pipeline's "Confirm and Run" gates query execution.
# Secure by default; set false only for a trusted automation context that
# has already reviewed this tradeoff.
REQUIRE_GENERATION_APPROVAL=true
# Max combined generation+web source invocations allowed per session within
# the window below -- a session-level cost ceiling, since a single question
# can already trigger both at once and nothing previously capped how many
# times one session could keep doing that. Not a substitute for real
# per-user auth (session_id is a correlation token, not an identity).
SESSION_EXPENSIVE_SOURCE_LIMIT=10
SESSION_EXPENSIVE_SOURCE_WINDOW_SECONDS=3600

# --- Voice mode (see voice/) -- local STT/TTS, no cloud API, same "fully
# local" posture as Ollama. On by default (unlike media generation, this
# costs nothing and calls no external API once its one-time local model
# downloads are done). When on, the React dashboard shows a mic button and
# its own settings toggle (GET /health's voice_enabled field is how the
# frontend knows to). A transcribed question is still plain untrusted
# text -- it goes through the exact same POST /ask path (and
# agent.input_guard.check_input) a typed question does. ---
ENABLE_VOICE_MODE=true
# faster-whisper model size (tiny/base/small/medium/large-v3) -- auto-
# downloaded from Hugging Face Hub on first use, cached locally after that.
STT_MODEL_SIZE=base
# cpu or cuda. Defaults to cpu -- nothing in this project's Docker setup
# assumes a GPU; only set cuda on a machine with a confirmed working
# CUDA + cuDNN setup.
STT_DEVICE=cpu
# Caps the schema-derived vocabulary hint fed to Whisper's initial_prompt
# (table/column names, so real schema terms are less likely to be
# misheard) -- short by design, not a full schema dump.
STT_VOCABULARY_MAX_CHARS=200
# Max size/duration of one recorded question, enforced before transcription
# (the same read-and-reject-if-over pattern as document uploads).
VOICE_MAX_UPLOAD_MB=10
VOICE_MAX_DURATION_SECONDS=30
# Piper voice model name -- download it once with:
#   python scripts/download_voice_model.py
TTS_VOICE=en_US-lessac-medium
# Override for where the Piper .onnx/.onnx.json pair lives, if not the
# default voice/models/<TTS_VOICE>.onnx.
TTS_VOICE_MODEL_PATH=

# --- Media search (optional, off by default -- see media/) ---
# Search an UNTAGGED local image/video library by plain-English content
# description (routed as the "media_search" orchestrator source -- see
# agent/orchestrator/nodes.py::media_search_node). Unlike every other
# optional source, the default embedding provider (local CLIP, via
# sentence-transformers) needs no API key and sends nothing to a third
# party -- but it does pull in torch and opencv-python, a real, larger
# dependency footprint than this project's other optional features, which
# is why this stays off by default. Both ENABLE_MEDIA_SEARCH=true and a
# real MEDIA_LIBRARY_PATH are required before this source becomes
# available (an enabled flag with no folder configured is not "available").
# After setting both, run: python scripts/build_media_index.py
ENABLE_MEDIA_SEARCH=true
MEDIA_LIBRARY_PATH=./media_library
# Only "local_clip" (on-device, no API key) is implemented today -- see
# media/embedding.py.
MEDIA_EMBEDDING_PROVIDER=local_clip
MEDIA_CLIP_MODEL_NAME=clip-ViT-B-32
# An Ollama vision-capable model name (e.g. "llava") for per-video-segment
# captioning -- pull it once with: ollama pull llava
# Blank (default) skips captioning; segments are still indexed and
# searchable via their ASR transcript + on-screen OCR text alone.
MEDIA_VISION_MODEL=
MEDIA_MAX_FILE_MB=200
MEDIA_SEARCH_TOP_K=5
# PySceneDetect's ContentDetector sensitivity -- lower detects more
# (subtler) scene changes, producing more video segments. 27.0 is
# PySceneDetect's own documented default.
MEDIA_SCENE_DETECT_THRESHOLD=27.0
# POST /search/media reuses the existing shared API_ACTION_RATE_LIMIT_PER_MINUTE
# (see below) rather than a dedicated limiter -- a query is cheap and
# orchestrator-routed questions are already bounded by /ask's own limiter.

# --- Content moderation gate (mandatory, not optional -- see moderation/) ---
# Runs before anything is embedded/stored by EITHER media search
# (ENABLE_MEDIA_SEARCH) or document/policy RAG (ENABLE_DOCUMENT_RAG/
# ENABLE_POLICY_RAG) -- there is deliberately no flag to turn this off
# while leaving either of those on. Ingestion for either pipeline fails
# closed with a clear error if the settings below aren't set.
#
# Only "azure_content_safety" is implemented today. Azure's real harm
# categories are Hate/SelfHarm/Sexual/Violence -- there is no dedicated
# "weapons"/"drugs"/"synthetic media" category; see
# moderation/taxonomy.py's module docstring for how those are covered
# instead (a text blocklist, and a disclosed placeholder, respectively).
MODERATION_PROVIDER=azure_content_safety
# Your Content Safety resource's endpoint, e.g.
# https://<resource-name>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# Minimum severity (0/2/4/6 on Azure's standard four-level scale) that
# triggers a hard-reject for the Hate/SelfHarm/Sexual/Violence categories.
# Verify this against your specific Content Safety API version.
MODERATION_SEVERITY_THRESHOLD=4
# Override for the weapons/drugs text-term blocklist YAML. Blank (default)
# uses config/moderation_blocklist.yaml.
MODERATION_BLOCKLIST_PATH=
#
# Dedicated SQL Server connection for moderation decisions/dedupe metadata
# (moderation/store.py's moderation.media_assets table) -- deliberately
# separate from both DB_CONNECTIONS and RAG_STORE_CONNECTION_STRING (see
# Settings.moderation_store_connection_string's docstring for why). Point
# this at the same physical database as RAG_STORE_CONNECTION_STRING if you
# want one shared metadata store -- that's your choice, not a requirement.
MODERATION_STORE_CONNECTION_STRING=
MODERATION_STORE_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# QueuePool sizing -- explicit here (unlike DB_CONNECTIONS/
# RAG_STORE_CONNECTION_STRING, which both rely on SQLAlchemy's defaults of
# 5/10) because ingestion can run many concurrent DB writes. Size against
# MEDIA_INGEST_WORKERS below plus normal concurrent PDF-upload traffic.
MODERATION_STORE_POOL_SIZE=10
MODERATION_STORE_MAX_OVERFLOW=20
# Below whatever idle-connection timeout your SQL Server instance/network
# enforces -- 1800s matches what DB_CONNECTIONS/RAG_STORE_CONNECTION_STRING
# both hardcode.
MODERATION_STORE_POOL_RECYCLE_SECONDS=1800
# Concurrent worker threads scripts/build_media_index.py uses to ingest
# files (moderation + embedding + DB writes per file) -- this project's
# first use of a bounded thread pool; previously a sequential loop.
MEDIA_INGEST_WORKERS=4
# An ingested image wider or taller than this (pixels) is split into a
# tile grid before moderation, so a classifier's own downsampling can't
# shrink away a small region of concern in a very large image.
MEDIA_IMAGE_TILE_THRESHOLD_PX=2048

# --- Docker Compose port binding (docker-compose.yml only -- NOT read by
# the Python app itself, purely Compose ${VAR} substitution) ---
# Localhost-only by default: an unqualified "8000:8000" mapping binds every
# host interface. Only widen this (e.g. to 0.0.0.0) once a real
# authenticating reverse proxy is in front -- see docs/DEPLOYMENT.md's
# "Reverse proxy and auth" section.
API_BIND_HOST=127.0.0.1
