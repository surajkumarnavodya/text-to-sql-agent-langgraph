# Mirrors .gitignore's intent for the build context: keep the image small,
# reproducible, and free of anything that shouldn't leave the host.

# --- Virtual environment / local Python artifacts ---
.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Secrets -- never baked into an image layer ---
.env
*.local.env

# --- Version control / editor / IDE ---
.git/
.gitignore
.gitattributes
.vs/
.vscode/
*.sln

# --- Local Chroma index -- regenerated by scripts/build_embeddings.py,
# not something that should be baked into the image or shipped stale ---
embeddings/.chroma/

# --- Downloaded Piper voice model -- see docs/DEPLOYMENT.md for the
# equivalent one-time `docker compose exec` step voice mode needs ---
voice/models/

# --- Frontend build artifacts -- the frontend-build stage installs its own
# node_modules and produces its own dist/ inside the image; the host's
# copies (if any, from running `npm install`/`npm run dev` locally) must
# never be sent as build context -- they're often huge and would silently
# shadow what `npm ci` inside the image actually installs. ---
frontend/node_modules/
frontend/dist/

# --- Docs/misc not needed inside the running container ---
docs/User_Guide.pdf
eval/results/
*.md
!README.md

# --- Docker files themselves ---
Dockerfile
docker-compose.yml
.dockerignore
